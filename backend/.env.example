PORT=5000
MONGODB_URI=mongodb://localhost:27017/studybuddy
JWT_SECRET=supersecretdev

# ---- Cloudinary ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Redis (required for BullMQ) ----
REDIS_URL=redis://localhost:6379

# ---- Google Cloud Vision (optional – falls back to Tesseract) ----
GOOGLE_APPLICATION_CREDENTIALS=

# ---- Google Gemini API (AI features) ----
GEMINI_API_KEY=your_gemini_api_key_here
# Default: gemini-1.5-flash (fast, cost-effective)
GEMINI_MODEL=gemini-1.5-flash
# Pro: used for viva (deeper reasoning)
GEMINI_PRO_MODEL=gemini-1.5-pro

# ---- ClamAV Virus Scanning (optional on dev) ----
CLAM_PATH=
